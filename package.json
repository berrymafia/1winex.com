{
  "name": "1win-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "server": "node server/index.js",
    "build": "vite build",
    "build:chat": "vite build --config vite.chat-widget.config.js",
    "build:corpus": "node scripts/build-site-corpus.mjs",
    "build:all": "npm run build:chat && npm run build:corpus && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "openai": "^5.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^5.4.0"
  }
}
