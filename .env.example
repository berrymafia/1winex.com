# OpenAI (required for /api/chat)
OPENAI_API_KEY=sk-...

# Optional model override (Responses API)
OPENAI_MODEL=gpt-4.1-mini

# API server
PORT=8787

# IP rate limit for POST /api/chat (requests per minute)
CHAT_RATE_LIMIT_PER_MIN=20

# Web search when site corpus is weak (Responses API). On by default.
# Set to 0 only if you want to disable it.
# CHAT_WEB_SEARCH=0

# SITE_ORIGIN=https://1winex.com
# SERVE_STATIC=1
# NODE_ENV=production
