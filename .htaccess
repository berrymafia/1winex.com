Options -Indexes -MultiViews +FollowSymLinks
DirectorySlash Off

AddType text/css .css
AddType application/javascript .js
AddType text/javascript .js
AddType image/png .png
AddType image/jpeg .jpg
AddType image/jpeg .jpeg
AddType image/gif .gif
AddType image/svg+xml .svg
AddType image/webp .webp
AddType image/x-icon .ico
AddType font/woff2 .woff2
AddType font/woff .woff
AddType application/xml .xml

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow" env=cta_hop
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host first, then CTA hops (so /go and /apk 302 from https://1winex.com)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://1winex.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} !^1winex\.com$ [NC]
  RewriteRule ^ https://1winex.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^go/?$ https://bonus-999.com/1win [R=302,L,NE,E=cta_hop:1]
  RewriteRule ^apk/?$ https://bonus-999.com/apk [R=302,L,NE,E=cta_hop:1]

  RewriteRule ^games(\.html)?/?$ https://1winex.com/casino [R=301,L,NE]
  RewriteRule ^sports(\.html)?/?$ https://1winex.com/betting [R=301,L,NE]
  RewriteRule ^mobile(\.html)?/?$ https://1winex.com/app [R=301,L,NE]
  RewriteRule ^ru/games(\.html)?/?$ https://1winex.com/ru/casino [R=301,L,NE]
  RewriteRule ^ru/sports(\.html)?/?$ https://1winex.com/ru/betting [R=301,L,NE]
  RewriteRule ^ru/mobile(\.html)?/?$ https://1winex.com/ru/app [R=301,L,NE]
  RewriteRule ^es/games(\.html)?/?$ https://1winex.com/es/casino [R=301,L,NE]
  RewriteRule ^es/sports(\.html)?/?$ https://1winex.com/es/betting [R=301,L,NE]
  RewriteRule ^es/mobile(\.html)?/?$ https://1winex.com/es/app [R=301,L,NE]
  RewriteRule ^fr/games(\.html)?/?$ https://1winex.com/fr/casino [R=301,L,NE]
  RewriteRule ^fr/sports(\.html)?/?$ https://1winex.com/fr/betting [R=301,L,NE]
  RewriteRule ^fr/mobile(\.html)?/?$ https://1winex.com/fr/app [R=301,L,NE]
  RewriteRule ^de/games(\.html)?/?$ https://1winex.com/de/casino [R=301,L,NE]
  RewriteRule ^de/sports(\.html)?/?$ https://1winex.com/de/betting [R=301,L,NE]
  RewriteRule ^de/mobile(\.html)?/?$ https://1winex.com/de/app [R=301,L,NE]
  RewriteRule ^uk/games(\.html)?/?$ https://1winex.com/uk/casino [R=301,L,NE]
  RewriteRule ^uk/sports(\.html)?/?$ https://1winex.com/uk/betting [R=301,L,NE]
  RewriteRule ^uk/mobile(\.html)?/?$ https://1winex.com/uk/app [R=301,L,NE]
  RewriteRule ^it/games(\.html)?/?$ https://1winex.com/it/casino [R=301,L,NE]
  RewriteRule ^it/sports(\.html)?/?$ https://1winex.com/it/betting [R=301,L,NE]
  RewriteRule ^it/mobile(\.html)?/?$ https://1winex.com/it/app [R=301,L,NE]
  RewriteRule ^az/games(\.html)?/?$ https://1winex.com/az/casino [R=301,L,NE]
  RewriteRule ^az/sports(\.html)?/?$ https://1winex.com/az/betting [R=301,L,NE]
  RewriteRule ^az/mobile(\.html)?/?$ https://1winex.com/az/app [R=301,L,NE]
  RewriteRule ^bn/games(\.html)?/?$ https://1winex.com/bn/casino [R=301,L,NE]
  RewriteRule ^bn/sports(\.html)?/?$ https://1winex.com/bn/betting [R=301,L,NE]
  RewriteRule ^bn/mobile(\.html)?/?$ https://1winex.com/bn/app [R=301,L,NE]
  RewriteRule ^hi/games(\.html)?/?$ https://1winex.com/hi/casino [R=301,L,NE]
  RewriteRule ^hi/sports(\.html)?/?$ https://1winex.com/hi/betting [R=301,L,NE]
  RewriteRule ^hi/mobile(\.html)?/?$ https://1winex.com/hi/app [R=301,L,NE]

  # Chat API is Node — never map /api/chat to a .html 404
  RewriteRule ^api/ - [L]

  # Locale folders are real directories; keep the public URLs without a trailing slash
  RewriteRule ^ru/$ https://1winex.com/ru [R=301,L,NE]
  RewriteRule ^ru$ ru/index.html [L]
  RewriteRule ^es/$ https://1winex.com/es [R=301,L,NE]
  RewriteRule ^es$ es/index.html [L]
  RewriteRule ^fr/$ https://1winex.com/fr [R=301,L,NE]
  RewriteRule ^fr$ fr/index.html [L]
  RewriteRule ^de/$ https://1winex.com/de [R=301,L,NE]
  RewriteRule ^de$ de/index.html [L]
  RewriteRule ^uk/$ https://1winex.com/uk [R=301,L,NE]
  RewriteRule ^uk$ uk/index.html [L]
  RewriteRule ^it/$ https://1winex.com/it [R=301,L,NE]
  RewriteRule ^it$ it/index.html [L]
  RewriteRule ^az/$ https://1winex.com/az [R=301,L,NE]
  RewriteRule ^az$ az/index.html [L]
  RewriteRule ^bn/$ https://1winex.com/bn [R=301,L,NE]
  RewriteRule ^bn$ bn/index.html [L]
  RewriteRule ^hi/$ https://1winex.com/hi [R=301,L,NE]
  RewriteRule ^hi$ hi/index.html [L]

  # Trailing slash on a file URL (/casino/) makes relative ./images and ./css
  # resolve to /casino/images — 404. Keep real directories as-is.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://1winex.com/$1 [R=301,L,NE]

  # Redirect root and localized index.html URLs to their canonical roots
  RewriteCond %{THE_REQUEST} \s/+((?:ru|es|fr|de|uk|it|az|bn|hi)/)?index(?:\.html)?[\s?] [NC]
  RewriteRule ^(?:(ru|es|fr|de|uk|it|az|bn|hi)/)?index(?:\.html)?$ https://1winex.com/$1 [R=301,L,NE]

  # Redirect /file.html to the canonical extensionless HTTPS URL
  RewriteCond %{THE_REQUEST} \s/+([^.]+)\.html[\s?] [NC]
  RewriteRule ^([^.]+)\.html$ https://1winex.com/$1 [R=301,L,NE]

  # Never rewrite existing static assets into .html
  RewriteRule ^(images|css|js)/ - [L]
  RewriteRule ^favicon\.png$ - [L]
  RewriteRule ^apple-touch-icon\.png$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(png|jpe?g|gif|svg|webp|ico|css|js|mjs|map|woff2?|ttf|eot|xml|json|txt)$ - [L]

  # Internally serve /file as /file.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Unknown URLs fall through to ErrorDocument with a real HTTP 404 status.
</IfModule>

ErrorDocument 404 /404.html
