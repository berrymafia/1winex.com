Options -Indexes -MultiViews +FollowSymLinks
DirectorySlash Off

AddType text/css .css
AddType application/javascript .js
AddType text/javascript .js
AddType image/png .png
AddType image/jpeg .jpg
AddType image/jpeg .jpeg
AddType image/gif .gif
AddType image/svg+xml .svg
AddType image/webp .webp
AddType image/x-icon .ico
AddType font/woff2 .woff2
AddType font/woff .woff
AddType application/xml .xml

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow" env=cta_hop
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host first, then CTA hops (so /go and /apk 302 from https://1winex.com)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.1winex\.com$ [NC]
  RewriteRule ^ https://1winex.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^go/?$ https://bonus-999.com/1win [R=302,L,NE,E=cta_hop:1]
  RewriteRule ^apk/?$ https://bonus-999.com/apk [R=302,L,NE,E=cta_hop:1]

  RewriteRule ^games(\.html)?/?$ /casino [R=301,L]
  RewriteRule ^sports(\.html)?/?$ /betting [R=301,L]
  RewriteRule ^mobile(\.html)?/?$ /app [R=301,L]
  RewriteRule ^ru/games(\.html)?/?$ /ru/casino [R=301,L]
  RewriteRule ^ru/sports(\.html)?/?$ /ru/betting [R=301,L]
  RewriteRule ^ru/mobile(\.html)?/?$ /ru/app [R=301,L]
  RewriteRule ^es/games(\.html)?/?$ /es/casino [R=301,L]
  RewriteRule ^es/sports(\.html)?/?$ /es/betting [R=301,L]
  RewriteRule ^es/mobile(\.html)?/?$ /es/app [R=301,L]
  RewriteRule ^fr/games(\.html)?/?$ /fr/casino [R=301,L]
  RewriteRule ^fr/sports(\.html)?/?$ /fr/betting [R=301,L]
  RewriteRule ^fr/mobile(\.html)?/?$ /fr/app [R=301,L]
  RewriteRule ^de/games(\.html)?/?$ /de/casino [R=301,L]
  RewriteRule ^de/sports(\.html)?/?$ /de/betting [R=301,L]
  RewriteRule ^de/mobile(\.html)?/?$ /de/app [R=301,L]
  RewriteRule ^uk/games(\.html)?/?$ /uk/casino [R=301,L]
  RewriteRule ^uk/sports(\.html)?/?$ /uk/betting [R=301,L]
  RewriteRule ^uk/mobile(\.html)?/?$ /uk/app [R=301,L]

  # Chat API is Node — never map /api/chat to a .html 404
  RewriteRule ^api/ - [L]

  # Locale folders are real directories; keep the public URLs without a trailing slash
  RewriteRule ^ru/$ /ru [R=301,L]
  RewriteRule ^ru$ ru/index.html [L]
  RewriteRule ^es/$ /es [R=301,L]
  RewriteRule ^es$ es/index.html [L]
  RewriteRule ^fr/$ /fr [R=301,L]
  RewriteRule ^fr$ fr/index.html [L]
  RewriteRule ^de/$ /de [R=301,L]
  RewriteRule ^de$ de/index.html [L]
  RewriteRule ^uk/$ /uk [R=301,L]
  RewriteRule ^uk$ uk/index.html [L]

  # Trailing slash on a file URL (/casino/) makes relative ./images and ./css
  # resolve to /casino/images — 404. Keep real directories as-is.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # Redirect index.html to the site root of this folder
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^index(\.html)?$ ./ [R=301,L]

  # Redirect /file.html to /file (relative substitution, not /%1)
  RewriteCond %{THE_REQUEST} \s/+([^.]+)\.html[\s?] [NC]
  RewriteRule ^([^.]+)\.html$ $1 [R=301,L]

  # Prefer nested public/ when the root copy is missing (ISPmanager repo upload)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^((?:images|css|js)/.*)$ public/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^((?:favicon|apple-touch-icon)\.png)$ public/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(images|css|js)/(.*)$ public/$1/$2 [L]

  # Never rewrite existing static assets into .html
  RewriteRule ^(images|css|js)/ - [L]
  RewriteRule ^favicon\.png$ - [L]
  RewriteRule ^apple-touch-icon\.png$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(png|jpe?g|gif|svg|webp|ico|css|js|mjs|map|woff2?|ttf|eot|xml|json|txt)$ - [L]

  # Internally serve /file as /file.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Localized 404 for unknown locale paths
  RewriteCond %{REQUEST_URI} ^/ru/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ ru/404.html [L]

  RewriteCond %{REQUEST_URI} ^/es/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ es/404.html [L]

  RewriteCond %{REQUEST_URI} ^/fr/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ fr/404.html [L]

  RewriteCond %{REQUEST_URI} ^/de/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ de/404.html [L]

  RewriteCond %{REQUEST_URI} ^/uk/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ uk/404.html [L]
</IfModule>

ErrorDocument 404 /404.html
